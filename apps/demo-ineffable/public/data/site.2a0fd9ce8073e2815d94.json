        ],
        "main": [
          {
            "type": "text",
            "html": "\n            <p class=\"w3-large\">Plexiform is an npm package which installs globally as a command line utility for scaffolding code from templates.</p>\n            <p class=\"w3-code\">\n                npm install -g plexiform\n            </p>\n        "
          }
        ]
      }
