{
  "name": "@r-a-i-t-h/tessera-editor-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed:user": "tsx scripts/make-seed-user.ts",
    "deconstruct:site": "tsx scripts/deconstruct-site.ts",
    "flatten:site": "tsx scripts/flatten-site.ts",
    "stamp:snapshot": "tsx scripts/stamp-snapshot.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@r-a-i-t-h/tessera-extras": "*",
    "@r-a-i-t-h/tessera-model": "*",
    "@r-a-i-t-h/tessera-renderer": "*",
    "@r-a-i-t-h/tessera-skin-w3": "*",
    "hono": "^4.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "tsx": "^4.20.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
