{
  "version": 1,
  "site": {
    "id": "pure-tessera",
    "title": "Tessera pure demo",
    "homePageId": "home",
    "theme": "teal"
  },
  "layouts": [
    {
      "id": "standard",
      "title": "Standard (title + main + aside + footer)",
      "root": {
        "type": "region",
        "role": "content",
        "children": [
          {
            "type": "region",
            "role": "main",
            "children": [
              {
                "type": "region",
                "tag": "h1",
                "className": "w3-text-theme w3-padding-16",
                "children": [
                  {
                    "type": "zone",
                    "id": "title"
                  }
                ]
              },
              {
                "type": "zone",
                "id": "main"
              },
              {
                "type": "region",
                "role": "row",
                "className": "w3-margin-top",
                "children": [
                  {
                    "type": "region",
                    "className": "w3-col m8",
                    "children": [
                      {
                        "type": "zone",
                        "id": "primary"
                      }
                    ]
                  },
                  {
                    "type": "region",
                    "className": "w3-col m4",
                    "children": [
                      {
                        "type": "region",
                        "tag": "h3",
                        "className": "w3-text-theme",
                        "children": [
                          {
                            "type": "static",
                            "html": "Aside"
                          }
                        ]
                      },
                      {
                        "type": "zone",
                        "id": "aside"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "region",
            "tag": "footer",
            "role": "footer",
            "className": "w3-theme-l3 w3-margin-top",
            "children": [
              {
                "type": "zone",
                "id": "footer"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "simple",
      "title": "Simple (no aside zone — aside content is hidden)",
      "root": {
        "type": "region",
        "role": "content",
        "children": [
          {
            "type": "region",
            "role": "main",
            "children": [
              {
                "type": "region",
                "tag": "h1",
                "className": "w3-text-theme w3-padding-16",
                "children": [
                  {
                    "type": "zone",
                    "id": "title"
                  }
                ]
              },
              {
                "type": "static",
                "html": "<div class=\"info-banner\">This page uses the <strong>simple</strong> layout. It does not declare an <code>aside</code> zone, so aside contributions from content are not shown — without editing that content.</div>"
              },
              {
                "type": "zone",
                "id": "main"
              },
              {
                "type": "zone",
                "id": "primary"
              }
            ]
          },
          {
            "type": "region",
            "tag": "footer",
            "role": "footer",
            "className": "w3-theme-l3 w3-margin-top",
            "children": [
              {
                "type": "zone",
                "id": "footer"
              }
            ]
          }
        ]
      }
    }
  ],
  "bindings": [
    {
      "id": "farm-open-days",
      "component": "eventList",
      "itemId": "open-days-data",
      "fromZone": "events",
      "props": {
        "limit": 10
      }
    },
    {
      "id": "sample-gallery",
      "component": "gallery",
      "props": {
        "folders": ["sample-gallery"],
        "mode": "grid"
      }
    },
    {
      "id": "sample-gallery-slides",
      "component": "gallery",
      "props": {
        "folders": ["sample-gallery"],
        "mode": "slides",
        "autoplay": true
      }
    }
  ],
  "items": [
    {
      "id": "common-footer",
      "title": "Shared footer",
      "zones": {
        "footer": [
          {
            "type": "text",
            "html": "<p>&copy; Tessera demo — content is data; components are site code. Time: </p>"
          },
          {
            "type": "component",
            "name": "now",
            "props": {
              "style": "font-weight:bold"
            }
          }
        ]
      }
    },
    {
      "id": "promo-aside",
      "title": "Promo blurb for aside",
      "zones": {
        "aside": [
          {
            "type": "text",
            "html": "<div class=\"w3-panel w3-pale-yellow w3-border\"><p><strong>Shared aside item.</strong> Visible only when the layout declares zone <code>aside</code>.</p></div>"
          }
        ]
      }
    },
    {
      "id": "open-days-data",
      "title": "Farm open days (data)",
      "zones": {
        "events": [
          {
            "type": "json",
            "data": [
              {
                "title": "Open farm day",
                "when": "Sat 10:00",
                "where": "Main barn"
              },
              {
                "title": "Volunteer briefing",
                "when": "Sun 09:30",
                "where": "Office"
              },
              {
                "title": "Evening talk",
                "when": "Thu 19:00",
                "where": "Marquee"
              }
            ]
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "id": "home",
      "title": "Home",
      "layoutId": "standard",
      "tags": [
        "page"
      ],
      "includes": [
        "common-footer",
        "promo-aside"
      ],
      "zones": {
        "title": [
          {
            "type": "text",
            "html": "Tessera rebuilt"
          }
        ],
        "main": [
          {
            "type": "text",
            "html": "<p>Formal <strong>layouts</strong> declare zones. Pages and shared items only <em>fill</em> them. Bindings live in site data — insert with <code>{{farm-open-days}}</code>.</p>"
          },
          {
            "type": "component",
            "name": "aboutRenderer"
          }
        ],
        "primary": [
          {
            "type": "text",
            "html": "<h3>Farm open days</h3><p class=\"w3-small\">Binding <code>farm-open-days</code> pairs item data with <code>eventList</code>. Mustache below:</p>{{farm-open-days}}"
          },
          {
            "type": "media",
            "id": "logo"
          }
        ],
        "aside": [
          {
            "type": "text",
            "html": "<p class=\"w3-small\">Page-level aside note (merged before shared promo item).</p>"
          }
        ]
      }
    },
    {
      "id": "no-aside",
      "title": "Same content, simple layout",
      "layoutId": "simple",
      "tags": [
        "page"
      ],
      "includes": [
        "common-footer",
        "promo-aside"
      ],
      "zones": {
        "title": [
          {
            "type": "text",
            "html": "Aside content still exists"
          }
        ],
        "main": [
          {
            "type": "text",
            "html": "<p>This page includes the same <code>promo-aside</code> item as Home, but layout <code>simple</code> has no <code>aside</code> zone. The same binding still works:</p>{{farm-open-days}}"
          }
        ]
      }
    },
    {
      "id": "components",
      "title": "Components",
      "layoutId": "standard",
      "tags": [
        "page"
      ],
      "includes": [
        "common-footer"
      ],
      "zones": {
        "title": [
          {
            "type": "text",
            "html": "Components &amp; web components"
          }
        ],
        "main": [
          {
            "type": "text",
            "html": "<p>Function components are plain TypeScript. Web components use <code>WCBase</code>. Binding as a component block:</p>"
          },
          {
            "type": "component",
            "name": "farm-open-days"
          },
          {
            "type": "component",
            "name": "infoCard",
            "props": {
              "title": "rt-card via registry"
            }
          },
          {
            "type": "text",
            "html": "<p>Inline page nav component:</p>"
          },
          {
            "type": "component",
            "name": "pageNav"
          }
        ],
        "aside": [
          {
            "type": "text",
            "html": "<p class=\"w3-small\">No shared promo on this page — only page aside.</p>"
          }
        ]
      }
    },
    {
      "id": "nav-lab",
      "title": "Nav lab",
      "layoutId": "standard",
      "tags": [
        "page"
      ],
      "includes": [
        "common-footer"
      ],
      "zones": {
        "title": [
          {
            "type": "text",
            "html": "Navigation presentations"
          }
        ],
        "main": [
          {
            "type": "text",
            "html": "<p><strong>Pages ≠ nav.</strong> Designed nav is authored; dynamic <code>source</code> pulls content-implied links. Presentation is a component choice — not a single system style.</p><h3>Tags</h3>"
          },
          {
            "type": "component",
            "name": "navTags"
          },
          {
            "type": "text",
            "html": "<h3>Full tree</h3>"
          },
          {
            "type": "component",
            "name": "navTree",
            "props": {
              "scope": "sidebar"
            }
          },
          {
            "type": "text",
            "html": "<h3>Collapsible regions</h3>"
          },
          {
            "type": "component",
            "name": "navCollapse",
            "props": {
              "scope": "sidebar"
            }
          }
        ],
        "aside": [
          {
            "type": "text",
            "html": "<p class=\"w3-small\">Try <code>#orphan</code> — that page exists but is not in designed nav.</p>"
          }
        ]
      }
    },
    {
      "id": "event-farm",
      "title": "Open farm day",
      "layoutId": "simple",
      "tags": [
        "event"
      ],
      "includes": [
        "common-footer"
      ],
      "zones": {
        "title": [
          {
            "type": "text",
            "html": "Open farm day"
          }
        ],
        "main": [
          {
            "type": "text",
            "html": "<p>Event page. Visible under designed nav only because <code>source.pagesTag: \"event\"</code> — not because the page exists.</p>"
          }
        ]
      }
    },
    {
      "id": "event-talk",
      "title": "Evening talk",
      "layoutId": "simple",
      "tags": [
        "event"
      ],
      "includes": [
        "common-footer"
      ],
      "zones": {
        "title": [
          {
            "type": "text",
            "html": "Evening talk"
          }
        ],
        "main": [
          {
            "type": "text",
            "html": "<p>Another event page for content-implied nav.</p>"
          }
        ]
      }
    },
    {
      "id": "orphan",
      "title": "Orphan page",
      "layoutId": "simple",
      "tags": [
        "hidden"
      ],
      "includes": [
        "common-footer"
      ],
      "zones": {
        "title": [
          {
            "type": "text",
            "html": "Orphan (not in nav)"
          }
        ],
        "main": [
          {
            "type": "text",
            "html": "<p>This page exists and is reachable at <code>#orphan</code>, but it is not listed in designed nav. Existence and visibility are distinct.</p>"
          }
        ]
      }
    },
    {
      "id": "gallery",
      "title": "Gallery",
      "layoutId": "standard",
      "tags": ["page"],
      "includes": ["common-footer"],
      "zones": {
        "title": [{ "type": "text", "html": "Gallery" }],
        "main": [
          {
            "type": "text",
            "html": "<p>First-class <strong>folder</strong> records are gallery sources. Scan with <code>npm run flatten:gallery</code> — no image-bank cherry-picking.</p><h3>Folder source (grid)</h3><p class=\"w3-small\">Binding props: <code>folders: [\"sample-gallery\"]</code>.</p>{{sample-gallery}}<h3>Same folder (slides + autoplay)</h3>{{sample-gallery-slides}}<h3>Inline <code>image</code> blocks</h3><p class=\"w3-small\">Explicit slide list nested on the component — same control, document order.</p>"
          },
          {
            "type": "component",
            "name": "gallery",
            "props": { "mode": "grid" },
            "zones": {
              "slides": [
                {
                  "type": "image",
                  "url": "./media/sample-gallery/01-red.svg",
                  "caption": "Inline crimson"
                },
                {
                  "type": "image",
                  "url": "./media/sample-gallery/04-blue.svg"
                },
                {
                  "type": "image",
                  "url": "./media/sample-gallery/05-teal.svg",
                  "caption": "Inline teal"
                }
              ]
            }
          }
        ],
        "aside": [
          {
            "type": "text",
            "html": "<p class=\"w3-small\">Captions: <code>meta.json</code> override, else filename with ordering prefix stripped (<code>01-red</code> → Red).</p>"
          }
        ]
      }
    }
  ],
  "media": [
    {
      "id": "logo",
      "title": "Demo image",
      "url": "./media/sample.svg",
      "type": "image",
      "alt": "Tessera sample"
    }
  ],
  "nav": [
    {
      "sidebar": true,
      "heading": "Site",
      "children": [
        {
          "sidebar": true,
          "id": "home",
          "title": "Home"
        },
        {
          "sidebar": true,
          "id": "no-aside",
          "title": "Simple layout"
        },
        {
          "sidebar": true,
          "id": "components",
          "title": "Components"
        },
        {
          "sidebar": true,
          "id": "nav-lab",
          "title": "Nav lab"
        },
        {
          "sidebar": true,
          "id": "gallery",
          "title": "Gallery"
        }
      ]
    },
    {
      "sidebar": true,
      "heading": "Events",
      "source": {
        "pagesTag": "event"
      }
    }
  ],
  "folders": [
    {
      "id": "sample-gallery",
      "path": "./media/sample-gallery",
      "title": "Sample gallery",
      "images": [
        {
          "file": "01-red.svg",
          "caption": "Crimson field",
          "alt": "Crimson field"
        },
        {
          "file": "02-amber.svg",
          "caption": "Amber field",
          "alt": "Amber field"
        },
        {
          "file": "03-green.svg",
          "caption": "Green field",
          "alt": "Green field"
        },
        {
          "file": "04-blue.svg",
          "caption": "Blue field",
          "alt": "Blue field"
        },
        {
          "file": "05-teal.svg",
          "caption": "Teal field",
          "alt": "Teal field"
        }
      ]
    }
  ]
}
