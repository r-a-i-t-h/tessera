{
  "version": 1,
  "site": {
    "id": "pure-tessera",
    "title": "Tessera pure demo",
    "homePageId": "home",
    "theme": "teal"
  },
  "layouts": [
    {
      "id": "standard",
      "title": "Standard (title + main + aside + footer)",
      "root": {
        "type": "region",
        "role": "content",
        "children": [
          {
            "type": "region",
            "role": "main",
            "children": [
              {
                "type": "region",
                "tag": "h1",
                "className": "w3-text-theme w3-padding-16",
                "children": [{ "type": "zone", "id": "title" }]
              },
              { "type": "zone", "id": "main" },
              {
                "type": "region",
                "role": "row",
                "className": "w3-margin-top",
                "children": [
                  {
                    "type": "region",
                    "className": "w3-col m8",
                    "children": [{ "type": "zone", "id": "primary" }]
                  },
                  {
                    "type": "region",
                    "className": "w3-col m4",
                    "children": [
                      {
                        "type": "region",
                        "tag": "h3",
                        "className": "w3-text-theme",
                        "children": [{ "type": "static", "html": "Aside" }]
                      },
                      { "type": "zone", "id": "aside" }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "region",
            "tag": "footer",
            "role": "footer",
            "className": "w3-theme-l3 w3-margin-top",
            "children": [{ "type": "zone", "id": "footer" }]
          }
        ]
      }
    },
    {
      "id": "simple",
      "title": "Simple (no aside zone — aside content is hidden)",
      "root": {
        "type": "region",
        "role": "content",
        "children": [
          {
            "type": "region",
            "role": "main",
            "children": [
              {
                "type": "region",
                "tag": "h1",
                "className": "w3-text-theme w3-padding-16",
                "children": [{ "type": "zone", "id": "title" }]
              },
              {
                "type": "static",
                "html": "<div class=\"info-banner\">This page uses the <strong>simple</strong> layout. It does not declare an <code>aside</code> zone, so aside contributions from content are not shown — without editing that content.</div>"
              },
              { "type": "zone", "id": "main" },
              { "type": "zone", "id": "primary" }
            ]
          },
          {
            "type": "region",
            "tag": "footer",
            "role": "footer",
            "className": "w3-theme-l3 w3-margin-top",
            "children": [{ "type": "zone", "id": "footer" }]
          }
        ]
      }
    }
  ],
  "items": [
    {
      "id": "common-footer",
      "title": "Shared footer",
      "zones": {
        "footer": [
          {
            "type": "text",
            "html": "<p>&copy; Tessera demo — content is data; components are site code. Time: </p>"
          },
          {
            "type": "component",
            "name": "now",
            "props": { "style": "font-weight:bold" }
          }
        ]
      }
    },
    {
      "id": "promo-aside",
      "title": "Promo blurb for aside",
      "zones": {
        "aside": [
          {
            "type": "text",
            "html": "<div class=\"w3-panel w3-pale-yellow w3-border\"><p><strong>Shared aside item.</strong> Visible only when the layout declares zone <code>aside</code>.</p></div>"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "id": "home",
      "title": "Home",
      "layoutId": "standard",
      "tags": ["page"],
      "includes": ["common-footer", "promo-aside"],
      "zones": {
        "title": [{ "type": "text", "html": "Tessera rebuilt" }],
        "main": [
          {
            "type": "text",
            "html": "<p>Formal <strong>layouts</strong> declare zones. Pages and shared items only <em>fill</em> them. Switch layout to hide a region without rewriting content.</p>"
          },
          {
            "type": "component",
            "name": "aboutRenderer"
          }
        ],
        "primary": [
          {
            "type": "text",
            "html": "<h3>Upcoming events</h3><p class=\"w3-small\">JSON lives in zone <code>events</code> (data only). The <code>eventList</code> component is imported in site TypeScript and registered by name.</p>"
          },
          {
            "type": "media",
            "id": "logo"
          },
          {
            "type": "component",
            "name": "eventList",
            "props": { "fromZone": "events", "limit": 10 }
          }
        ],
        "events": [
          {
            "type": "json",
            "data": [
              { "title": "Open farm day", "when": "Sat 10:00", "where": "Main barn" },
              { "title": "Volunteer briefing", "when": "Sun 09:30", "where": "Office" },
              { "title": "Evening talk", "when": "Thu 19:00", "where": "Marquee" }
            ]
          }
        ],
        "aside": [
          {
            "type": "text",
            "html": "<p class=\"w3-small\">Page-level aside note (merged before shared promo item).</p>"
          }
        ]
      }
    },
    {
      "id": "no-aside",
      "title": "Same content, simple layout",
      "layoutId": "simple",
      "tags": ["page"],
      "includes": ["common-footer", "promo-aside"],
      "zones": {
        "title": [{ "type": "text", "html": "Aside content still exists" }],
        "main": [
          {
            "type": "text",
            "html": "<p>This page includes the same <code>promo-aside</code> item and page aside text as Home, but layout <code>simple</code> has no <code>aside</code> zone — so none of it appears.</p>"
          }
        ],
        "primary": [
          {
            "type": "text",
            "html": "<p>Events still render because <code>eventList</code> is placed in <code>primary</code>, which this layout keeps.</p>"
          },
          {
            "type": "component",
            "name": "eventList",
            "props": { "fromZone": "events" }
          }
        ],
        "events": [
          {
            "type": "json",
            "data": [
              { "title": "Hidden-layout check", "when": "Whenever", "where": "Data zone still readable" }
            ]
          }
        ],
        "aside": [
          {
            "type": "text",
            "html": "<p>You should <strong>not</strong> see this on the simple layout.</p>"
          }
        ]
      }
    },
    {
      "id": "components",
      "title": "Components",
      "layoutId": "standard",
      "tags": ["page"],
      "includes": ["common-footer"],
      "zones": {
        "title": [{ "type": "text", "html": "Components &amp; web components" }],
        "main": [
          {
            "type": "text",
            "html": "<p>Function components are plain TypeScript. Web components use <code>WCBase</code> and are registered on the registry as elements.</p>"
          },
          {
            "type": "component",
            "name": "infoCard",
            "props": { "title": "rt-card via registry" }
          },
          {
            "type": "text",
            "html": "<p>Inline page nav component:</p>"
          },
          { "type": "component", "name": "pageNav" }
        ],
        "aside": [
          {
            "type": "text",
            "html": "<p class=\"w3-small\">No shared promo on this page — only page aside.</p>"
          }
        ]
      }
    }
  ],
  "media": [
    {
      "id": "logo",
      "title": "Demo image",
      "url": "./media/sample.svg",
      "type": "image",
      "alt": "Tessera sample"
    }
  ],
  "nav": [
    { "sidebar": true, "heading": "Pages" },
    { "sidebar": true, "id": "home", "title": "Home" },
    { "sidebar": true, "id": "no-aside", "title": "Simple layout" },
    { "sidebar": true, "id": "components", "title": "Components" }
  ]
}
